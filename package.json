{
  "name": "desktop-pet",
  "version": "1.1.1",
  "description": "AI 桌面宠物（AI 对话 · 自定义工具 · Taskt 自动化）",
  "author": "颍川",
  "homepage": "https://github.com/yingchuan-1024/PetAI-Desktop-Pet",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.jinyuwan.petai",
    "productName": "PetAI",
    "directories": {
      "output": "dist-taskt"
    },
    "extraResources": [{ "from": "taskt-runtime", "to": "taskt" }],
    "asarUnpack": [
      "tools/automation-helper.ps1",
      "tools/automation-helper.cs"
    ],
    "files": [
      "main.js",
      "preload.js",
      "agent.js",
      "agent-bridge.js",
      "automation.js",
      "taskt.js",
      "tools/automation-helper.ps1",
      "tools/automation-helper.cs",
      "renderer/**/*",
      "skins/**/*",
      "assets/**/*",
      "LICENSE",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/app-icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PetAI 桌宠"
    }
  }
}
